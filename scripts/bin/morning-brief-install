#!/bin/zsh
# Installs the LaunchAgent that runs morning-brief on weekday mornings and on wake.
# Usage: morning-brief-install [--uninstall | --print]

set -u -o pipefail

LABEL=com.peter-rebrun.morning-brief
PLIST=$HOME/Library/LaunchAgents/$LABEL.plist
DOMAIN=gui/$(id -u)
LOG=$HOME/Library/Logs/morning-brief.log

# Every 15 minutes from 08:15 to 11:45, then hourly to 17:00 for a laptop opened late.
intervals() {
  local h m
  for h in 8 9 10 11; do
    for m in 0 15 30 45; do
      (( h == 8 && m == 0 )) && continue
      print "    <dict><key>Hour</key><integer>$h</integer><key>Minute</key><integer>$m</integer></dict>"
    done
  done
  for h in {12..17}; do
    print "    <dict><key>Hour</key><integer>$h</integer><key>Minute</key><integer>0</integer></dict>"
  done
}

plist() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-l</string>
    <string>$HOME/bin/morning-brief</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
$(intervals)
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
}

unload() {
  launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1 && launchctl bootout "$DOMAIN/$LABEL"
  return 0
}

case "${1:-}" in
  --print)
    plist
    ;;
  --uninstall)
    unload
    rm -f "$PLIST"
    echo "Removed $LABEL"
    ;;
  "")
    [[ -x $HOME/bin/morning-brief ]] || { echo "~/bin/morning-brief missing: run 'stow scripts' first" >&2; exit 1 }
    mkdir -p "${PLIST:h}" "${LOG:h}"
    plist > "$PLIST"
    plutil -lint "$PLIST" || exit 1
    unload
    launchctl bootstrap "$DOMAIN" "$PLIST" || exit 1
    echo "Installed $LABEL (log: $LOG)"
    ;;
  *)
    echo "Usage: ${0:t} [--uninstall | --print]" >&2
    exit 2
    ;;
esac
